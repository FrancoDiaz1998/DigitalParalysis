    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigitalParalysis.Application\DigitalParalysis.Application.csproj" />
    <ProjectReference Include="..\DigitalParalysis.Infrastructure\DigitalParalysis.Infrastructure.csproj" />
  </ItemGroup>

